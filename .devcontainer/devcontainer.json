// How GitHub Codespaces sets up the cloud machine for this repo (see "Training on GitHub
// Codespaces" in the README).
{
  "name": "rocketlander",
  "image": "mcr.microsoft.com/devcontainers/python:3.13",
  "features": {
    // Lets you reach the codespace from your own terminal: gh codespace ssh / gh codespace cp.
    "ghcr.io/devcontainers/features/sshd:1": {}
  },
  // Runs once, when the codespace is created: install uv, then the project's dependencies.
  "postCreateCommand": "curl -LsSf https://astral.sh/uv/install.sh | sh && ~/.local/bin/uv sync",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"]
    }
  }
}
